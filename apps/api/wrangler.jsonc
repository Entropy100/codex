{
  "name": "entropy-cloud-api", "main": "src/index.ts", "compatibility_date": "2025-03-20",
  "d1_databases": [{ "binding": "DB", "database_name": "entropy-cloud", "database_id": "REPLACE_WITH_D1_DATABASE_ID", "migrations_dir": "migrations" }],
  "kv_namespaces": [{ "binding": "KV", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }],
  "r2_buckets": [{ "binding": "BUCKET", "bucket_name": "entropy-cloud-files" }],
  "vars": { "DASHBOARD_ORIGIN": "http://localhost:5173", "CLOUDFLARE_ACCOUNT_ID": "" }
}
